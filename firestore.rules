rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
      allow create, update: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /inventory/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" || (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "staff"] &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.category == resource.data.category &&
          request.resource.data.unit == resource.data.unit &&
          request.resource.data.reorderLevel == resource.data.reorderLevel &&
          request.resource.data.price == resource.data.price &&
          request.resource.data.quantity is number &&
          request.resource.data.updatedAtMs is number
        )
      );
    }

    match /inventoryCategories/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /menu/{docId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /staff/{docId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "staff"];
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /schedule/{docId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "staff"];
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /orders/{docId} {
      allow create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "staff"];
      allow read: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      // Staff may only touch the inventory-audit fields (written atomically by
      // the deduction transaction during a sale or offline sync) plus the order
      // status transitions: cancel (soft-void flags + status "cancelled") or
      // mark prepared (status "done"). Every other field is locked to admins.
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "staff"] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "inventoryAlerts",
            "inventoryDeductions",
            "inventorySkips",
            "inventoryDeductionProgress",
            "inventoryDeductionFailed",
            "voided",
            "voidedAtMs",
            "voidedBy",
            "voidReason",
            "status",
            "cancelledAtMs",
            "preparedAtMs",
            "preparedBy"
          ]) &&
          (
            // Inventory audit written atomically by the deduction transaction
            // during a sale or offline sync (incl. the failure flag written by
            // the retry path). No lifecycle change, so this must not require a
            // status transition.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "inventoryAlerts",
              "inventoryDeductions",
              "inventorySkips",
              "inventoryDeductionProgress",
              "inventoryDeductionFailed"
            ]) ||
            // Cancel / soft-void transition
            (
              request.resource.data.get("voided", false) == true &&
              request.resource.data.voidedAtMs is number &&
              request.resource.data.voidedBy is string &&
              request.resource.data.status == "cancelled"
            ) ||
            // Mark-prepared transition
            (
              request.resource.data.get("voided", false) != true &&
              request.resource.data.status == "done" &&
              request.resource.data.preparedAtMs is number
            )
          )
        )
      );
    }

    match /resets/{dateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";

      match /orders/{orderDocId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      }
    }

    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /dailyStats/{docId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "staff"];
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "staff"];
    }

    match /kitchenOrders/{docId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "staff"];
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "staff"];
    }

    match /drawerLogs/{docId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "staff"];
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "staff"];
    }
  }
}
